# Example environment variables only. Set real values in your hosting dashboard.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace_with_a_new_secret_key
DJANGO_ALLOWED_HOSTS=your-app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
